# Production backend env. Replace every placeholder on the VPS.
# This file is an example only; do not copy real values into Git.

APP_ENV=production
PORT=8080

DB_HOST=postgres
DB_PORT=5432
DB_USER=algoedgefno_prod_app
DB_PASSWORD=replace-with-strong-production-db-password
DB_NAME=algoedgefno_prod
# Postgres TLS. The single-VPS deployment runs Postgres on a private Docker
# network without TLS, so plain TCP is the topology and DB_SSL_REQUIRED=false
# is correct. When the prod DB moves to managed Postgres (Cloud SQL, RDS,
# Timescale Cloud, etc.), unset this or set it to true so the app fails closed
# unless TLS is actually negotiated.
DB_SSL_REQUIRED=false

JWT_SECRET=replace-with-strong-production-jwt-secret

MIGRATIONS_PATH=file:///app/migrations
AUTO_MIGRATE=false
TRUSTED_PROXIES=172.16.0.0/12

BACKTEST_ENABLED=true
BACKTEST_MAX_DAYS=1825
BACKTEST_MAX_CANDLES=0
SYNC_ENABLED=true

# Firebase Auth (production project — must differ from staging project)
FIREBASE_PROJECT_ID=algoedgefno-prod
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-serviceaccount-prod.json
FIREBASE_WEB_API_KEY=replace-with-production-firebase-web-api-key
# Comma-separated list of Firebase UIDs allowed to exchange a session token.
# (The parser splits on commas; a space-separated value is treated as ONE UID.)
# Seeded with the owner UID captured from the Firebase Console before the
# launch deploy is dispatched (§10 Step 2). Never set TEST_UID_* here.
# Post-launch, append PROD_SMOKE_UID comma-separated, e.g. owner-uid,smoke-uid.
ALLOWED_FIREBASE_UIDS=replace-with-owner-firebase-uid

# PROD_SMOKE_UID: appended post-launch per §10 Step 9 once the owner's real
# production Firebase account exists and the first /auth/session has succeeded.
# Drives the post-launch mutating smoke (smoke_mode=standard) by the deploy wrapper.
# Leave commented out until Step 9 is complete.
# PROD_SMOKE_UID=replace-with-production-smoke-uid
