# Staging backend env. Replace every placeholder on the VPS.
# This file is an example only; do not copy real values into Git.

APP_ENV=staging
PORT=8080

DB_HOST=postgres
DB_PORT=5432
DB_USER=algoedgefno_staging_app
DB_PASSWORD=replace-with-strong-staging-db-password
DB_NAME=algoedgefno_staging

JWT_SECRET=replace-with-strong-staging-jwt-secret
APP_SECRET_TOKEN=replace-with-strong-staging-app-token

MIGRATIONS_PATH=file:///app/migrations
AUTO_MIGRATE=false

BACKTEST_ENABLED=true
BACKTEST_MAX_DAYS=90
BACKTEST_MAX_CANDLES=5000
SYNC_ENABLED=false
