# Staging backend env. Replace every placeholder on the VPS.
# This file is an example only; do not copy real values into Git.

APP_ENV=staging
PORT=8080

DB_HOST=postgres
DB_PORT=5432
DB_USER=algoedgefno_staging_app
DB_PASSWORD=replace-with-strong-staging-db-password
DB_NAME=algoedgefno_staging
# Postgres TLS — see notes in prod.env.example. Same topology applies to staging.
DB_SSL_REQUIRED=false

JWT_SECRET=replace-with-strong-staging-jwt-secret
APP_SECRET_TOKEN=replace-with-strong-staging-app-token

MIGRATIONS_PATH=file:///app/migrations
AUTO_MIGRATE=false
TRUSTED_PROXIES=172.16.0.0/12

BACKTEST_ENABLED=true
BACKTEST_MAX_DAYS=90
BACKTEST_MAX_CANDLES=5000
SYNC_ENABLED=false

# Firebase Auth (staging project — must differ from prod project)
FIREBASE_PROJECT_ID=algoedgefno-staging
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-serviceaccount-staging.json
FIREBASE_WEB_API_KEY=replace-with-staging-firebase-web-api-key
# Space-separated list of Firebase UIDs allowed to exchange a session token.
# Staging: include TEST_UID_A, TEST_UID_B, TEST_UID_DENIED, TEST_UID_CONFLICT
# plus the owner's staging UID (if signing in to staging from Android).
ALLOWED_FIREBASE_UIDS=uid-a uid-b uid-denied uid-conflict

# Rate limit for /auth/session (requests per minute per IP).
AUTH_RATE_LIMIT_RPM=10

# Staging-only Firebase test user UIDs — provisioned by setup-firebase-test-users.
# These UIDs must exist in the staging Firebase project; never set them in prod.env.
TEST_UID_A=replace-with-staging-test-uid-a
TEST_UID_B=replace-with-staging-test-uid-b
TEST_UID_DENIED=replace-with-staging-test-uid-denied
TEST_UID_CONFLICT=replace-with-staging-test-uid-conflict
