# Production migration env. Replace every placeholder on the VPS.
# This file is an example only; do not copy real values into Git.
#
# Migration jobs intentionally use the admin/owner role so they can apply DDL.
# Runtime production services must keep using prod.env with the app role.

APP_ENV=production

DB_HOST=postgres
DB_PORT=5432
DB_USER=replace-with-postgres-admin-user
DB_PASSWORD=replace-with-strong-postgres-admin-password
DB_NAME=algoedgefno_prod
DB_SSL_REQUIRED=false
