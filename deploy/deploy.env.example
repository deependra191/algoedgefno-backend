# Non-secret Compose variables. Copy to /opt/algoedgefno/compose/.env on the server.

BACKEND_IMAGE=ghcr.io/deependra191/algoedgefno-backend@sha256:replace-with-image-digest
POSTGRES_IMAGE=timescale/timescaledb:2.26.4-pg16

PROD_API_HOST=api.algoedgefno.example
STAGING_API_HOST=staging-api.algoedgefno.example

# Local validation can override this to a temporary directory containing sanitized env files.
# On the server, leave unset so Compose reads /opt/algoedgefno/env/*.env.
# ENV_DIR=/opt/algoedgefno/env
