PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=replace-with-local-db-user
DB_PASSWORD=replace-with-local-db-password
DB_NAME=replace-with-local-db-name
# Postgres TLS. Local dev usually runs Postgres without TLS, so false is correct.
# Default when unset is true (fail-closed for managed Postgres).
DB_SSL_REQUIRED=false
# Replace JWT_SECRET with a strong random value before deploying.
JWT_SECRET=replace-with-local-random-jwt-secret
# APP_ENV is the sole environment selector. Valid values: development, staging, production, test.
APP_ENV=development
# MIGRATIONS_PATH defaults to file://migrations (relative to working directory).
# In production set this to an absolute path: file:///opt/algoedgefno/migrations
# MIGRATIONS_PATH=file://migrations
# AUTO_MIGRATE defaults to true in development/test and false in staging/production.
# AUTO_MIGRATE=false

# NSE provider — browser-fingerprinting headers required to pass NSE's bot detection.
# Override here if NSE starts blocking the default strings (no recompile needed).
# NSE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
# NSE_ACCEPT_HTML=text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8

# Startup-evaluated kill switches and cost-control limits.
# All values are read at process start; changing them requires a backend or sync restart to take effect.
#
# BACKTEST_ENABLED=false blocks all new backtest submissions (returns 503). Running backtests are not cancelled.
# BACKTEST_ENABLED=true
#
# BACKTEST_MAX_DAYS: calendar-inclusive date range cap; 0 means no limit. Default: 1825 (5 years).
# Staging env files should set a lower value (e.g. 90) to reduce compute cost.
# BACKTEST_MAX_DAYS=1825
#
# BACKTEST_MAX_CANDLES: post-fetch engine-safety guard; 0 means no limit (default).
# This check runs AFTER candles are read from the DB — it does not protect DB read cost.
# Use BACKTEST_MAX_DAYS to constrain DB read cost. Only set this when post-fetch protection is needed.
# BACKTEST_MAX_CANDLES=0
#
# SYNC_ENABLED=false makes cmd/sync exit cleanly before connecting to the DB. Default: true.
# Affects new cmd/sync invocations only; a running sync is not interrupted.
# SYNC_ENABLED=true
