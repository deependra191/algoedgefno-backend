PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=dbname
# Replace JWT_SECRET and APP_SECRET_TOKEN with strong random values before deploying.
JWT_SECRET=jwtsecret
APP_SECRET_TOKEN=appsecrettoken
# APP_ENV is the sole environment selector. Valid values: development, staging, production, test.
APP_ENV=development
# MIGRATIONS_PATH defaults to file://migrations (relative to working directory).
# In production set this to an absolute path: file:///opt/algoedgefno/migrations
# MIGRATIONS_PATH=file://migrations
# AUTO_MIGRATE defaults to true in development/test and false in staging/production.
# AUTO_MIGRATE=false

# NSE provider — browser-fingerprinting headers required to pass NSE's bot detection.
# Override here if NSE starts blocking the default strings (no recompile needed).
# NSE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
# NSE_ACCEPT_HTML=text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8
