PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=replace-with-local-db-user
DB_PASSWORD=replace-with-local-db-password
DB_NAME=replace-with-local-db-name
# Replace JWT_SECRET and APP_SECRET_TOKEN with strong random values before deploying.
JWT_SECRET=replace-with-local-random-jwt-secret
APP_SECRET_TOKEN=replace-with-local-random-app-token
# APP_ENV is the sole environment selector. Valid values: development, staging, production, test.
APP_ENV=development
# MIGRATIONS_PATH defaults to file://migrations (relative to working directory).
# In production set this to an absolute path: file:///opt/algoedgefno/migrations
# MIGRATIONS_PATH=file://migrations
# AUTO_MIGRATE defaults to true in development/test and false in staging/production.
# AUTO_MIGRATE=false

# NSE provider — browser-fingerprinting headers required to pass NSE's bot detection.
# Override here if NSE starts blocking the default strings (no recompile needed).
# NSE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
# NSE_ACCEPT_HTML=text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8

# Kill switches and cost-control limits.
# Set BACKTEST_ENABLED=false to disable all backtest submissions globally (returns 503).
# BACKTEST_ENABLED=true
# BACKTEST_MAX_DAYS: maximum date range in days; 0 means no limit. Default: 730 (2 years).
# Staging should use a lower value (e.g. 90) to limit compute cost.
# BACKTEST_MAX_DAYS=730
# BACKTEST_MAX_CANDLES: maximum candle count per run (signal or trade, whichever is larger); 0 means no limit. Default: 20000.
# Staging should use a lower value (e.g. 5000).
# BACKTEST_MAX_CANDLES=20000
# Set SYNC_ENABLED=false to disable NSE EOD sync (cmd/sync exits immediately without connecting to the DB).
# SYNC_ENABLED=true
# LIVE_TICK_ENABLED is a placeholder for Phase 3 live tick streaming; no-op in v1.
# LIVE_TICK_ENABLED=false
